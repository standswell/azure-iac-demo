{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "uksouth"
    },
    "namePrefix": {
      "value": "iacdemo"
    },
    "adminUsername": {
      "value": "azureuser"
    },
    "sshPublicKey": {
      "value": "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"
    },
    "vmSize": {
      "value": "Standard_D4s_v5"
    },
    "osDiskSizeGB": {
      "value": 128
    },
    "installOllama": {
      "value": true
    },
    "allowSshFromInternet": {
      "value": false
    },
    "sshSourceAddressPrefix": {
      "value": "YOUR_PUBLIC_IP/32"
    }
  }
}
